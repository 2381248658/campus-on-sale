{
	"name": "backend",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/app.js",
	"scripts": {
		"dev": "nodemon --watch src --ext ts,js --exec \"node --loader ts-node/esm\" src/app.ts",
		"build": "rimraf dist && tsc",
		"start": "node dist/app.js",
		"seed": "node --loader ts-node/esm src/seed/index.ts",
		"seed:reset": "node --loader ts-node/esm src/seed/index.ts --reset"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "校园惠后端 - ESM版",
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.4.1",
		"openai": "^6.42.0"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.6.0",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"ts-node-dev": "^2.0.0",
		"typescript": "^6.0.2"
	}
}
